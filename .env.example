# ========================================
# Kaze - Environment Configuration
# ========================================

# App
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
FASTIFY_CLOSE_GRACE_DELAY=500

# App connections (used when app runs on host)
DATABASE_URL=postgresql://admin:pass@localhost:5432/kaze
REDIS_URL=redis://localhost:6379

# Postgres container settings (used by docker compose)
POSTGRES_DB=kaze
POSTGRES_USER=admin
POSTGRES_PASSWORD=pass
POSTGRES_PORT=5432

# Redis container settings (used by docker compose)
REDIS_PORT=6379

# Logging
LOG_LEVEL=info
