# ========================================
# Kaze - Distributed Rate Limiter
# Environment Configuration
# ========================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Upstream demo service (Week 1)
UPSTREAM_BASE_URL=http://127.0.0.1:4000

# Rate Limiting Configuration (Phase 1)
# Window duration in milliseconds (default: 60000ms = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# Burst capacity (how many tokens can accumulate)
RATE_LIMIT_BURST_SIZE=10

# Token refill rate (tokens per second)
RATE_LIMIT_REFILL_RATE=10

# Redis Configuration (Phase 3 - Distributed Mode)
# Uncomment when implementing Redis integration
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_KEY_PREFIX=kaze:

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Security (Phase 4)
# API_KEY_REQUIRED=false
# ALLOWED_ORIGINS=*

# Monitoring (Phase 4)
# METRICS_ENABLED=true
# METRICS_PORT=9090
