# ========================================
# Kaze - Distributed Rate Limiter
# Environment Configuration
# ========================================

# Gateway
PORT=3000
NODE_ENV=development

# Upstream (Week 1)
UPSTREAM_BASE_URL=http://127.0.0.1:4000

# Admin Auth (Week 2)
# Both are required for admin endpoints.
ADMIN_API_KEY=change-me
ADMIN_BASIC_USER=admin
ADMIN_BASIC_PASS=change-me

# Rules Cache (Week 2)
# How often the gateway refreshes enabled rules from Postgres.
RULES_REFRESH_MS=5000

# Postgres (Week 2)
DATABASE_URL=postgresql://admin:pass@localhost:5432/kaze

# Redis (Week 3)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=kaze:

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
