# ========================================
# Kaze - Environment Configuration
# ========================================

# App
NODE_ENV=development
PORT=3000
HOST_PORT=3000
UPSTREAM_BASE_URL=http://127.0.0.1:4000

# Rules refresh interval (ms)
RULES_REFRESH_MS=5000

# App DB connection (used when app runs on host)
DATABASE_URL=postgresql://admin:pass@localhost:5432/kaze

# Postgres container settings (used by docker compose)
POSTGRES_DB=kaze
POSTGRES_USER=admin
POSTGRES_PASSWORD=pass
POSTGRES_PORT=5432

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
