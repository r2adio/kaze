{
	"name": "kaze",
	"version": "0.1.0",
	"description": "A high-performance distributed rate limiting service",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "tsc",
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.js",
		"dev:upstream": "npm --prefix upstream run dev",
		"start:upstream": "npm --prefix upstream run start",
		"biome:check": "npx @biomejs/biome check --write",
		"test": "vitest run",
		"test:watch": "vitest --watch"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.14",
		"@types/node": "^25.6.0",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5"
	},
	"dependencies": {
		"fastify": "^5.8.5",
		"zod": "^4.4.2"
	}
}
