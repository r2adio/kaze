{
	"name": "kaze",
	"version": "0.1.1",
	"description": "A high-performance distributed rate limiting service",
	"type": "module",
	"private": true,
	"scripts": {
		"start": "npm run build:ts && fastify start -l info dist/app.js",
		"build:ts": "tsc",
		"watch:ts": "tsc -w",
		"dev": "npm run build:ts && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:watch:ts\" \"npm:dev:start\"",
		"dev:start": "fastify start --ignore-watch=.ts$ -w -l info -P dist/app.js",
		"check": "npx @biomejs/biome check",
		"check:write": "npx @biomejs/biome check --write",
		"test": "npm run build:ts && tsc -p test/tsconfig.json && c8 node --test -r tsx \"test/**/*.ts\""
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@types/node": "^25.9.3",
		"@types/pg": "^8.20.0",
		"c8": "^11.0.0",
		"concurrently": "^10.0.3",
		"drizzle-kit": "^0.31.10",
		"fastify-tsconfig": "^3.0.0",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@fastify/autoload": "^6.3.1",
		"@fastify/sensible": "^6.0.4",
		"close-with-grace": "^2.5.0",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"fastify": "^5.8.5",
		"fastify-cli": "^8.0.0",
		"fastify-plugin": "^6.0.0",
		"pg": "^8.21.0",
		"zod": "^4.4.3"
	}
}
