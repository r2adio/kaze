{
	"name": "kaze",
	"version": "0.1.1",
	"description": "A high-performance distributed rate limiting service",
	"type": "module",
	"private": true,
	"scripts": {
		"build": "tsc",
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.js",
		"dev:upstream": "npm --prefix upstream run dev",
		"start:upstream": "npm --prefix upstream run start",
		"dev:all": "concurrently \"npm run dev\" \"npm run dev:upstream\"",
		"biome:check": "npx @biomejs/biome check --write",
		"lint": "npx @biomejs/biome check",
		"test": "vitest run",
		"test:watch": "vitest --watch"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@types/node": "^25.8.0",
		"@types/pg": "^8.20.0",
		"concurrently": "^9.2.1",
		"drizzle-kit": "^0.31.10",
		"tsx": "^4.22.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.6"
	},
	"dependencies": {
		"@fastify/reply-from": "^12.6.2",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"fastify": "^5.8.5",
		"pg": "^8.20.0",
		"redis": "^6.0.0",
		"zod": "^4.4.3"
	}
}
